# Production .env for /home/prec/precious-real-estate-web/.env
#
# Create it in cPanel > File Manager (enable "Show Hidden Files"), paste this,
# and fill in every <...>. It is never committed and never uploaded by the
# deploy workflow. See deploy/README.md.

APP_NAME="Precious Real Estate Consulting"
APP_ENV=production
APP_DEBUG=false
# Generate locally with: php artisan key:generate --show
APP_KEY=<base64:...>
APP_URL=https://preciousrealestate.mw
APP_TIMEZONE=Africa/Blantyre

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel > MySQL Databases. cPanel prefixes names with the account user.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=prec_website
DB_USERNAME=prec_webuser
DB_PASSWORD=<database user password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# No queue worker on shared hosting — send mail inline.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# cPanel > Email Accounts > info@preciousrealestate.mw > Connect Devices
# shows the exact server name/port if these differ.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.preciousrealestate.mw
MAIL_PORT=465
MAIL_USERNAME=info@preciousrealestate.mw
MAIL_PASSWORD=<mailbox password>
MAIL_FROM_ADDRESS=info@preciousrealestate.mw
MAIL_FROM_NAME="Precious Real Estate Consulting"
MAIL_TO_ADDRESS=info@preciousrealestate.mw
MAIL_SIGNATURE=

# First CMS login — used ONCE, only while the users table is empty.
# Delete the PASSWORD line after you've logged in for the first time.
CMS_BOOTSTRAP_NAME="Comfort Khonje"
CMS_BOOTSTRAP_EMAIL=comfort@abstractmw.com
CMS_BOOTSTRAP_PASSWORD=<choose a strong password>

# Optional, once a GA4 property exists
GOOGLE_ANALYTICS_ID=

VITE_APP_NAME="${APP_NAME}"
